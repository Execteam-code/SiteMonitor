@model ServiceMonitor.Web.Models.Entities.Service

@{
    ViewData["Title"] = "Добавить сервис";
}

<div class="container mt-4">
    <h2>Добавить новый сервис</h2>
    <hr />
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Название сервиса</label>
                            <input asp-for="Name" class="form-control" placeholder="Например: YouTube" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="TargetUrl" class="form-label fw-bold">URL адрес</label>
                            <input asp-for="TargetUrl" class="form-control" placeholder="Например: https://youtube.com" />
                            <span asp-validation-for="TargetUrl" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Отмена</a>
                            <button type="submit" class="btn btn-success">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
