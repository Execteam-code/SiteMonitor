<!DOCTYPE html>
<html lang="ru" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Site Monitor</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        body { display: flex; flex-direction: column; min-height: 100vh; background-color: #f8f9fa; }
        main { flex: 1; }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-activity text-success me-2"></i>Site Monitor
                </a>
                
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Переключатель навигации">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Дашборд
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Services" asp-action="Index">
                                    <i class="bi bi-gear me-1"></i> Настройки сервисов
                                </a>
                            </li>
                        </ul>
                        
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm shadow-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Выйти
                            </button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main role="main" class="container mt-4 mb-5 pb-5">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top shadow-sm">
        <div class="container text-center text-muted">
            <small>&copy; @DateTime.Now.Year — Site Monitor MVP. Разработано на ASP.NET Core MVC.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
