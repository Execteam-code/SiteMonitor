~@{
    Layout = null; 
    ViewData["Title"] = "Вход в систему";
}

<!DOCTYPE html>
<html lang="ru" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Site Monitor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="d-flex align-items-center py-4 h-100">

    <main class="w-100 m-auto px-3" style="max-width: 400px;">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-shield-lock-fill text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Site Monitor</h3>
                    <p class="text-muted small">Вход для администратора</p>
                </div>
                
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 shadow-sm text-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Неверный пароль
                        </div>
                    }
                    
                    <div class="form-floating mb-4 text-start">
                        <input type="password" class="form-control focus-ring" id="passwordInput" name="password" placeholder="Пароль" required autofocus>
                        <label for="passwordInput" class="text-muted">Пароль доступа</label>
                    </div>
                    
                    <button class="btn btn-primary w-100 py-2 shadow-sm fw-bold" type="submit">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Войти
                    </button>
                </form>
            </div>
        </div>
        <p class="mt-4 mb-3 text-muted text-center small">&copy; @DateTime.Now.Year — MVP Dashboard</p>
    </main>

</body>
</html>

